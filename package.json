{
  "name": "dental-school-life-sim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A cozy bilingual (EN/ZH) dental school life-simulation game. Static, GitHub Pages deployable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "smoke": "mkdir -p /scratch/$USER/dsls-v2 && esbuild scripts/smoke.mts --bundle --platform=node --format=esm --outfile=/scratch/$USER/dsls-v2/smoke.bundle.mjs && node /scratch/$USER/dsls-v2/smoke.bundle.mjs --quick",
    "balance": "mkdir -p /scratch/$USER/dsls-v2 && esbuild scripts/smoke.mts --bundle --platform=node --format=esm --outfile=/scratch/$USER/dsls-v2/balance.bundle.mjs && node /scratch/$USER/dsls-v2/balance.bundle.mjs",
    "validate-content": "mkdir -p /scratch/$USER/dsls-v2 && esbuild content-gen/validate.mts --bundle --platform=node --format=esm --outfile=/scratch/$USER/dsls-v2/validate.bundle.mjs && node /scratch/$USER/dsls-v2/validate.bundle.mjs",
    "test:migration": "mkdir -p /scratch/$USER/dsls-v2 && esbuild scripts/migration-test.mts --bundle --platform=node --format=esm --outfile=/scratch/$USER/dsls-v2/migration-test.bundle.mjs && node /scratch/$USER/dsls-v2/migration-test.bundle.mjs",
    "test:render": "mkdir -p /scratch/$USER/dsls-v2 && esbuild scripts/render-smoke.tsx --bundle --platform=node --format=cjs --outfile=/scratch/$USER/dsls-v2/render-smoke.bundle.cjs && node /scratch/$USER/dsls-v2/render-smoke.bundle.cjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
